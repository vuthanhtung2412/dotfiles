macos-option-as-alt = true
theme = Catppuccin Mocha
window-save-state = always
font-size = 16
cursor-style = bar

# Occupy whole screen
# https://www.reddit.com/r/Ghostty/comments/1jx9dmq/comment/mms4y6s
maximize = true

# https://github.com/ghostty-org/ghostty/discussions/3716
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0
window-padding-color = extend
adjust-cell-height = -7% # Optional

